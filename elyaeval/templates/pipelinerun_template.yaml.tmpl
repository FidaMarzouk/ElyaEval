# Generated by `elyaeval init-ci`. Committed here because THIS run's
# identity (which repo, which branch, which blob container results get
# uploaded under) is specific to this SUT repo — the shared recipe
# (tasks.yaml / pipeline.yaml) stays centralized and is NOT duplicated
# into this repo. See recipes/tekton/README (elyaeval repo) for how the
# shared Task/Pipeline definitions get applied to a cluster.
#
# test-file must match whatever `elyaeval init --task-type ...` actually
# wrote in this repo (default naming: test_elyaeval_<task_type>.py) — if
# you rename or regenerate that file, regenerate this PipelineRun too, or
# edit the value below to match.
#
# sut-url and judge-* are left as shell placeholders on purpose — they
# depend on the machine/cluster you're applying this from (e.g.
# host.docker.internal vs. a real in-cluster Ollama Service, or which
# judge provider you're running against), not on this repo. Set them
# before applying:
#
#   $env:SUT_URL = "http://host.docker.internal:8000"
#
#   # --- local (Ollama / any OpenAI-compatible server) ---
#   $env:JUDGE_PROVIDER = "local"
#   $env:JUDGE_MODEL_NAME = "llama3.1"
#   $env:JUDGE_BASE_URL = "http://host.docker.internal:11434/v1"
#
#   # --- anthropic ---
#   #   $env:JUDGE_PROVIDER = "anthropic"
#   #   $env:JUDGE_MODEL_NAME = "claude-sonnet-4-6"
#   #   $env:JUDGE_BASE_URL = ""   # ignored for anthropic, must still be set (see below)
#
#   # --- openai ---
#   #   $env:JUDGE_PROVIDER = "openai"
#   #   $env:JUDGE_MODEL_NAME = "gpt-4.1"
#   #   $env:JUDGE_BASE_URL = ""   # ignored for openai, must still be set (see below)
#
#   envsubst < pipelinerun.yaml | kubectl create -n elyaeval -f -
#
# (Plain Linux kind, no Docker Desktop: use the kind bridge gateway IP
#   instead of host.docker.internal —
#   docker network inspect kind -f '{{(index .IPAM.Config 0).Gateway}}')
#
# JUDGE_BASE_URL must always be set to SOME string (even "") before
# envsubst runs, or envsubst leaves the literal ${{JUDGE_BASE_URL}} text in
# the applied YAML. It's only actually consulted by run-suite when
# judge-provider is "local" — see tasks.yaml.
#
# judge-api-key-secret-name/key below point at the SAME Secret regardless
# of provider — for anthropic/openai it must hold a real API key; for
# local/Ollama it only needs to exist (Ollama doesn't validate the value).
# Create/update it before applying, e.g.:
#   kubectl create secret generic judge-model-credentials `
#     --from-literal=api-key=$env:ANTHROPIC_API_KEY `
#     -n elyaeval --dry-run=client -o yaml | kubectl apply -f -
#
# blob-storage-credentials holds the full Azure Storage connection string
# (Azurite locally, a real Storage Account in higher envs). Create/update
# it once per cluster/namespace before applying:
#   kubectl create secret generic blob-storage-credentials `
#     --from-literal=connection-string=$env:AZURE_STORAGE_CONNECTION_STRING `
#     -n elyaeval --dry-run=client -o yaml | kubectl apply -f -
apiVersion: tekton.dev/v1
kind: PipelineRun
metadata:
  generateName: elyaeval-rag-recipe-run-
spec:
  pipelineRef:
    name: elyaeval-rag-recipe
  params:
    - name: repo-url
      value: {repo_url}
    - name: revision
      value: {revision}
    - name: sut-url
      value: ${{SUT_URL}}
    - name: test-file
      value: {test_file}

    # Judge model — left as shell placeholders, see the comment block above
    # for what to set per provider. judge-api-key-secret-* stay fixed:
    # same Secret is reused across providers, only its contents change.
    - name: judge-provider
      value: ${{JUDGE_PROVIDER}}
    - name: judge-model-name
      value: ${{JUDGE_MODEL_NAME}}
    - name: judge-model-base-url
      value: ${{JUDGE_BASE_URL}}
    - name: judge-api-key-secret-name
      value: judge-model-credentials
    - name: judge-api-key-secret-key
      value: api-key

    - name: blob-container
      value: {blob_container}
    - name: blob-connection-string-secret-name
      value: blob-storage-credentials
    - name: blob-connection-string-secret-key
      value: connection-string
  workspaces:
    - name: source
      volumeClaimTemplate:
        spec:
          accessModes: ["ReadWriteOnce"]
          resources:
            requests:
              storage: 1Gi
