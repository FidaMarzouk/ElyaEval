# Generated by `elyaeval init-ci`. Committed here because THIS run's
# identity (which repo, which branch, where results get published) is
# specific to this SUT repo — the shared recipe (tasks.yaml / pipeline.yaml)
# stays centralized and is NOT duplicated into this repo. See
# recipes/tekton/README (elyaeval repo) for how the shared Task/Pipeline
# definitions get applied to a cluster.
#
# This file assumes the elyaeval-rag-recipe Pipeline (from elyaeval
# recipe-tag {elyaeval_version}) is already applied to the target cluster.
# If check-results or run-suite fail with "pipeline not found", that's a
# sign the cluster's recipes/tekton/ hasn't been applied, or is applied
# from a different tag than this file was generated against.
#
# test-file must match whatever `elyaeval init --task-type ...` actually
# wrote in this repo (default naming: test_elyaeval_<task_type>.py) — if
# you rename or regenerate that file, regenerate this PipelineRun too, or
# edit the value below to match.
#
# sut-url and judge-model-* are left as shell placeholders on purpose —
# they depend on the machine/cluster you're applying this from (e.g.
# host.docker.internal vs. a real in-cluster Ollama Service), not on this
# repo. Set them before applying:
#
#   $env:SUT_URL = "http://host.docker.internal:8000"
#   $env:JUDGE_MODEL_NAME = "llama3.1"
#   $env:JUDGE_BASE_URL = "http://host.docker.internal:11434/v1"
#   envsubst < pipelinerun.yaml | kubectl create -n elyaeval-ci -f -
#
# (Plain Linux kind, no Docker Desktop: use the kind bridge gateway IP
# instead of host.docker.internal —
#   docker network inspect kind -f '{{(index .IPAM.Config 0).Gateway}}')
apiVersion: tekton.dev/v1
kind: PipelineRun
metadata:
  generateName: elyaeval-rag-recipe-run-
spec:
  pipelineRef:
    name: elyaeval-rag-recipe
  params:
    - name: repo-url
      value: {repo_url}
    - name: revision
      value: {revision}
    - name: sut-url
      value: ${{SUT_URL}}
    - name: test-file
      value: {test_file}

    # Judge model — left as shell placeholders, see note above.
    # judge-api-key-secret-* stay fixed: Ollama doesn't validate the key,
    # so the Secret just needs to exist with any placeholder value.
    - name: judge-model-name
      value: ${{JUDGE_MODEL_NAME}}
    - name: judge-model-base-url
      value: ${{JUDGE_BASE_URL}}
    - name: judge-api-key-secret-name
      value: judge-model-credentials
    - name: judge-api-key-secret-key
      value: api-key

    - name: results-repo-url
      value: {results_repo_url}
    - name: results-branch
      value: {results_branch}
    - name: results-secret-name
      value: git-write-credentials
    - name: results-secret-key
      value: token
  workspaces:
    - name: source
      volumeClaimTemplate:
        spec:
          accessModes: ["ReadWriteOnce"]
          resources:
            requests:
              storage: 1Gi
