def _expected_tools_from_golden(golden) -> list[ToolCall]:
    """
    TODO 3: builds ground-truth ToolCall objects from additional_metadata,
    the same place gold_context_indices lives for RAG goldens. Expects:

        "additional_metadata": {{
            "expected_tools": [
                {{"name": "search_flights", "input_parameters": {{"origin": "SFO"}}}}
            ]
        }}

    Adjust this if your goldens file encodes expected tools differently,
    or leave it returning [] if you're only checking tools_called shape
    manually rather than scoring against ground truth.
    """
    raw = (golden.additional_metadata or {{}}).get("expected_tools", [])
    return [ToolCall(name=t["name"], input_parameters=t.get("input_parameters")) for t in raw]


GOLDENS = load_standard_dataset(task_type="{task_type}", ci_stage="{ci_stage}")


@pytest.mark.parametrize(
    "golden",
    GOLDENS,
    ids=[g.additional_metadata.get("priority", "") + "_" + str(i) for i, g in enumerate(GOLDENS)],
)
def test_{task_type}(golden):
    run_result = run_app(golden.input)

    test_case = LLMTestCase(
        input=golden.input,
        actual_output=run_result.actual_output,
        expected_output=golden.expected_output,
        tools_called=run_result.tools_called,
        expected_tools=_expected_tools_from_golden(golden),
    )

    # One evaluate() call per golden (test_cases=[test_case], never the
    # whole GOLDENS list) — keeps scoring per-golden and gives each a
    # clean row (or rows, one per metric) in REPORT_CSV.
    result = evaluate_golden(golden, test_case, {metrics_constant}, csv_path=REPORT_CSV)
    assert result.success, f"{{result.name}} failed — see {{REPORT_CSV}} for per-metric scores"
